{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../workflow-engine/tsconfig.lib.json"
    },
    {
      "path": "../testing/tsconfig.lib.json"
    },
    {
      "path": "../datom/tsconfig.lib.json"
    },
    {
      "path": "../store-sqlite-node/tsconfig.lib.json"
    },
    {
      "path": "../store-postgres/tsconfig.lib.json"
    }
  ]
}
