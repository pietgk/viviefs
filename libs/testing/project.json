{
  "name": "testing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/testing/src",
  "projectType": "library",
  "tags": [
    "kind:lib",
    "layer:testing",
    "platform:universal"
  ],
  "metadata": {
    "rationale": "generic test helpers and the suite catalogue (D80)"
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "libs/testing"
      }
    }
  }
}
