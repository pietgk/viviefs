{
  "name": "@viviefs/evidence-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@viviefs/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@viviefs/platform-native": "workspace:*",
    "effect": "4.0.0-rc.116",
    "expo": "58.0.0-preview.3",
    "expo-crypto": "58.0.1",
    "expo-dev-client": "58.0.3",
    "expo-status-bar": "58.0.0",
    "react": "19.2.3",
    "react-native": "0.88.0-rc.0"
  },
  "devDependencies": {
    "@expo/agent-cli": "1.0.16",
    "@types/react": "19.2.2"
  },
  "expo": {
    "agentCli": {
      "target": "dev-build",
      "buildBackend": "local"
    }
  }
}
