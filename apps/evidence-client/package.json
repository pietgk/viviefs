{
  "name": "@viviefs/evidence-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@viviefs/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@effect/sql-sqlite-react-native": "4.0.5",
    "@effect/sql-sqlite-wasm": "4.0.5",
    "@expo/metro-runtime": "58.0.15",
    "@op-engineering/op-sqlite": "18.2.5",
    "@viviefs/datom": "workspace:*",
    "@viviefs/evidence-model": "workspace:*",
    "@viviefs/identity": "workspace:*",
    "@viviefs/platform-native": "workspace:*",
    "@viviefs/store-sqlite-native": "workspace:*",
    "@viviefs/store-sqlite-wasm": "workspace:*",
    "@viviefs/sync-client": "workspace:*",
    "@viviefs/telemetry": "workspace:*",
    "@viviefs/testing": "workspace:*",
    "@viviefs/workflow-engine": "workspace:*",
    "effect": "4.0.5",
    "expo": "58.0.17",
    "expo-auth-session": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-notifications": "58.1.6",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@expo/agent-cli": "1.0.16",
    "@types/react": "19.3.0"
  },
  "expo": {
    "agentCli": {
      "target": "dev-build",
      "buildBackend": "local"
    }
  },
  "op-sqlite": {
    "iosSqlite": true
  }
}
