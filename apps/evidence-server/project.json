{
  "name": "evidence-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/evidence-server/src",
  "projectType": "application",
  "tags": [
    "kind:app",
    "platform:server"
  ],
  "metadata": {
    "rationale": "Node composition root: authenticated sync RPCs over HTTP. The HTTP round trip runs in test-integration; P11 qualifies it."
  },
  "targets": {
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "pnpm exec vitest run --config vitest.integration.config.ts",
        "cwd": "apps/evidence-server"
      }
    }
  }
}
